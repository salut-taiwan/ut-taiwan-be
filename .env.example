PORT=3001
NODE_ENV=development

# Database (Drizzle ORM — use Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TBO Karunika
TBO_BASE_URL=http://tbo.karunika.co.id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Resend (email notifications)
RESEND_API_KEY=re_...
# NOTE: when setting EMAIL_FROM in a deployment platform's env-var UI, do NOT
# wrap the value in quotes — quotes become part of the value and Resend will
# reject the send with `Invalid 'from' field` (422).
EMAIL_FROM=UT Taiwan <noreply@yourdomain.com>