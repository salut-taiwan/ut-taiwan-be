{
  "name": "ut-taiwan-be",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "node bin/www",
    "dev": "nodemon bin/www",
    "scraper": "node scraper/index.js",
    "test": "node --test --test-reporter=spec 'test/{config,format,presenters,routes,services,middleware,scraper,utils}/**/*.test.js'",
    "test:watch": "node --test --watch --test-reporter=spec 'test/{config,format,presenters,routes,services,middleware,scraper,utils}/**/*.test.js'",
    "test:system": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=60000 'test/system/**/*.test.js'",
    "test:system:up": "docker compose -f test/system/docker-compose.yml up -d --wait",
    "test:system:down": "docker compose -f test/system/docker-compose.yml down -v",
    "test:all": "npm test && npm run test:system",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='scraper/tboScraper.js' --test-coverage-exclude='scraper/tokopediaScraper.js' --test-coverage-exclude='scraper/runTokopedia.js' --test-coverage-exclude='scraper/index.js' --test-coverage-exclude='db/schema.js' --test-coverage-exclude='drizzle/**' --test-coverage-exclude='migrations/**' 'test/{config,format,presenters,routes,services,middleware,scraper,utils}/**/*.test.js'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "~4.16.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.50.1",
    "postgres": "^3.4.9",
    "resend": "^6.9.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
